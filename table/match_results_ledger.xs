// Official locked match outcomes certified by Gemini AI Referee
table match_results_ledger {
  auth = false

  schema {
    int id
    timestamp created_at?=now
  
    // Maps directly to the resolved match lobby
    int match_id {
      table = "match_lobby"
    }
  
    // Official bracket winner certified by Gemini
    int winning_player_id {
      table = "user"
    }
  
    // Literal match count string (e.g. 3-1, 16-12)
    text final_score_string filters=trim
  
    // Encrypted certification hash generated by Gemini
    text gemini_verification_hash filters=trim
  
    // Flags true the moment daily wager balances are released to winners
    bool wagering_payout_triggered?
  }

  index = [
    {type: "primary", field: [{name: "id"}]}
    {type: "btree|unique", field: [{name: "match_id"}]}
    {type: "btree", field: [{name: "winning_player_id"}]}
    {type: "btree", field: [{name: "wagering_payout_triggered"}]}
  ]
}
# Copy this file to .env and fill in the values from your own backend.
# Never commit .env — it is listed in .gitignore.

# Lovable Cloud / Supabase backend
SUPABASE_PROJECT_ID=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Browser-side copies (Vite only exposes VITE_-prefixed vars)
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Payments: Stripe client token used by the test-mode banner (pk_test_... or pk_live_...)
VITE_PAYMENTS_CLIENT_TOKEN=
